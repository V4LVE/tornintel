# Copy to .env (or .env.local) and fill in. Never commit real values.

# PostgreSQL for shared TBS evidence, travel tracking and levelling list changes.
# Leave empty to run without shared storage; the app falls back gracefully.
# Run `npm run db:migrate` after setting it.
# Example: postgres://tornintel:password@localhost:5432/tornintel
DATABASE_URL=

# The dashboard tracks the opponent from the viewer's current or last ranked war.
# Optional fallback faction ID (digits only) when no ranked war is found.
TORN_ENEMY_FACTION_ID=

# Better Auth: a random secret of at least 32 characters, required in production.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app.
BETTER_AUTH_URL=http://localhost:3000

# Set to 1 to run the PostgreSQL integration tests against DATABASE_URL.
TORNINTEL_DB_TEST=
